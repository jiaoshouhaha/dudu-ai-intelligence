# 可选：兼容 OpenAI Chat Completions 协议的模型服务。
# 未配置时，抓取、去重、规则评分和网站均可正常运行。
AI_API_KEY=
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_MODEL=qwen-flash
AI_DAILY_LIMIT=100
AI_CONCURRENCY=2
AI_TIMEOUT_MS=30000

# 每次运行的成本与负载保护
MAX_NEW_ITEMS_PER_RUN=80
FEED_TIMEOUT_MS=15000
RETENTION_DAYS=365

